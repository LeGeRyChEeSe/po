# A shell script with CRLF line endings does not run on Linux, macOS or Termux: the shell reads
# the carriage return as part of the command. These scripts exist precisely to validate those
# platforms, so Git must never convert them.
*.sh text eol=lf
*.py text eol=lf
gradlew text eol=lf

# Everything else follows the platform's convention.
* text=auto
